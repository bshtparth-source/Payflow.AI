# Payflow AI Backend Environment Configuration

# Server configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
USE_MOCK_DATA=true

# CORS Allowed Origins (comma separated or specific domain)
CORS_ORIGINS=http://localhost:3000,https://payflow-ai.vercel.app

# Database (SQLite by default, swap to Postgres on Railway/Render)
DATABASE_URL=sqlite:///./payflow.db

# LLM Provider Configuration (configurable by env, do not hardcode a provider)
LLM_PROVIDER=openai
LLM_API_KEY=your_api_key_here
LLM_MODEL=gpt-4o-mini
# Or for Gemini:
# LLM_PROVIDER=gemini
# LLM_API_KEY=your_gemini_key_here
# LLM_MODEL=gemini-1.5-flash
